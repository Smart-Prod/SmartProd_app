<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartProd_Mobile_Front_end.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SmartProd_Mobile_Front_end.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SmartProd"
    Shell.BackgroundColor="#FF8C00"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <TabBar>
        <ShellContent Title="Login"
            ContentTemplate="{DataTemplate views:LoginPage}"
            Route="LoginPage" />
        <ShellContent Title=" Registrar"
            ContentTemplate="{DataTemplate views:RegistrationPage}"
            Route="RegistrationPage" />
    </TabBar>

</Shell>
