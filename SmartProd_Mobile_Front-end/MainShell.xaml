<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SmartProd_Mobile_Front_end.Views"
       x:Class="SmartProd_Mobile_Front_end.MainShell"
       Shell.FlyoutBehavior="Disabled"
       Title="SmartProd"
       Shell.BackgroundColor="#FF8C00"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White">

    <TabBar>
        <ShellContent Title="Produção"
            ContentTemplate="{DataTemplate views:ProductionPage}"
            Route="ProductionPage" />
        <ShellContent Title="Scanner"
            ContentTemplate="{DataTemplate views:ScannerPage}"
            Route="ScannerPage" />
        <ShellContent Title="Dashboard"
            ContentTemplate="{DataTemplate views:AdminDashboardPage}"
            Route="AdminDashboardPage" />
    </TabBar>

</Shell>
