<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartProd_Mobile_Front_end.Views.LoginPage"
             Title="LoginPage"
             BackgroundColor="#F5F6FA">
    <ScrollView>
        <VerticalStackLayout Spacing="0" VerticalOptions="Center" Padding="30,50">

            <!-- Logo Container -->
            <VerticalStackLayout Spacing="8" Margin="0,0,0,48" HorizontalOptions="Center">
                <Label Text="SMARTPROD"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#FF8C00"
                   HorizontalOptions="Center"
                   CharacterSpacing="-1" />
            </VerticalStackLayout>

            <!-- Card Design -->
            <Border BackgroundColor="White"
               StrokeThickness="0"
               StrokeShape="RoundRectangle 4"
               Padding="24,40"
               Margin="0,0,0,40">

                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.15"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="32">

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="Autenticação do Operador"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                        <Label Text="Insira suas credenciais para iniciar sessão"
                           FontSize="14"
                           TextColor="#5A7C8A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Input Fields -->
                    <VerticalStackLayout Spacing="24">

                        <!-- Email Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="E-MAIL"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#5A7C8A"
                               CharacterSpacing="1" />
                            <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,12">
                             <Entry Placeholder="operador@smartprod.io"
                                    PlaceholderColor="#A0AEC0"
                                TextColor="#333333"
                                     Keyboard="Email"
                                     Text="{Binding Email}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Access Key Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="SENHA DE ACESSO"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#5A7C8A"
                               CharacterSpacing="1" />
                            <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,12">
                                <Entry Placeholder="••••••••••••"
                                    IsPassword="True"
                                     PlaceholderColor="#A0AEC0"
                                     TextColor="#333333"
                                     Text="{Binding Senha}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Options -->
                        <Grid ColumnDefinitions="Auto,*"
                             ColumnSpacing="20"
                             VerticalOptions="Center">
                            <!-- Checkbox + Texto -->
                            <HorizontalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <CheckBox IsChecked="False" Color="#FF8C00" VerticalOptions="Center" />
                                <Label Text="Manter Sessão"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   TextColor="#5A7C8A" />
                            </HorizontalStackLayout>
                            <!-- Forgot Password -->
                            <Label Grid.Column="1"
                               Text="Esqueceu a Senha?"
                               TextColor="#FF8C00"
                               FontAttributes="Bold"
                               FontSize="13"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Primary Action -->
                    <Button Text="ENTRAR"
                        BackgroundColor="#FF8C00"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="56"
                        CornerRadius="4"
                        CharacterSpacing="1"
                        Command="{Binding LoginCommand}"/>

                    <Label Text="Criar Conta"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#FF8C00"
                           HorizontalOptions="Center"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCriarContaTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Status Footer -->
                    <Label Text="Conexão Segura • Servidor: Linha-04"
                           FontSize="12" TextColor="#A0AEC0"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Bottom Brand Info -->
            <VerticalStackLayout Spacing="24" HorizontalOptions="Center">
                <Label Text="© 2026 SMARTPROD SISTEMAS INDUSTRIAIS LTDA. V.4.0.2"
                   FontSize="10"
                   TextColor="#8BA6B1"
                   HorizontalTextAlignment="Center"
                   CharacterSpacing="0.5" />

                <HorizontalStackLayout Spacing="24" HorizontalOptions="Center">
                    <Label Text="PRIVACIDADE" FontSize="10" FontAttributes="Bold" TextColor="#5A7C8A" />
                    <Label Text="STATUS DO SISTEMA" FontSize="10" FontAttributes="Bold" TextColor="#5A7C8A" />
                    <Label Text="SUPORTE" FontSize="10" FontAttributes="Bold" TextColor="#5A7C8A" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>