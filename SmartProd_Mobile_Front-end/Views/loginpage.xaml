<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartProd_Mobile_Front_end.Views.LoginPage"
             Title="Login"
             BackgroundColor="#F8F6F2">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="32,60">

            <!-- Logo -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,0,0,48">
                <Label Text="SMARTPROD"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="#FF8C00"
                       HorizontalOptions="Center"
                       CharacterSpacing="2" />
                <Label Text="Gestão Industrial Inteligente"
                       FontSize="13"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Login Card -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="24,32"
                    Margin="0,0,0,32">

                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,4"
                            Radius="16"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="24">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Acessar Sistema"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#071E27" />
                        <Label Text="Insira suas credenciais para continuar"
                               FontSize="14"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-MAIL"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,12">
                            <Entry Placeholder="seu@email.com"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#071E27"
                                   Keyboard="Email"
                                   Text="{Binding Email}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Senha -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SENHA"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,12">
                            <Entry Placeholder="••••••••"
                                   IsPassword="True"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#071E27"
                                   Text="{Binding Senha}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button Text="ENTRAR"
                            BackgroundColor="#FF8C00"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="52"
                            CornerRadius="10"
                            Command="{Binding LoginCommand}" />

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="© 2026 SmartProd Systems"
                   FontSize="12"
                   TextColor="#9CA3AF"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
