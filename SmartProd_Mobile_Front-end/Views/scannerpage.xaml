<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartProd_Mobile_Front_end.Views.ScannerPage"
             Title="Scanner Industrial"
             Shell.NavBarIsVisible="True"
             BackgroundColor="#1A202C">

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, *, Auto"
              Padding="0,0,12,0"
              VerticalOptions="Center">
            <Label Grid.Column="0"
                   Text="SMARTPROD"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#FF8C00"
                   CharacterSpacing="1.5"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="QR Code &amp; NFC"
                   FontSize="13"
                   TextColor="#A0AEC0"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   Margin="0,0,8,0" />
            <Border Grid.Column="2"
                    HeightRequest="34"
                    WidthRequest="34"
                    Stroke="#FF8C00"
                    StrokeThickness="1.5"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 17">
                <Image Source="operator_avatar.png"
                       Aspect="AspectFill" />
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*, Auto">

        <!-- Dark overlay for readability -->
        <BoxView Grid.Row="0"
                 Color="#000000"
                 Opacity="0.45" />

        <!-- Scanner Interface Overlay -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" VerticalOptions="Start" Padding="20,12">

                <!-- Header Badge da Ordem de Produção -->
                <Border BackgroundColor="#2D3748" 
                        Padding="14,8" 
                        Stroke="#FF8C00"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding OrderInfoText}" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#FF8C00" />
                        <Label Text="{Binding ExpectedMaterialsText}" 
                               FontSize="11" 
                               TextColor="#CBD5E0" 
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Status de Hardware NFC -->
                <Border BackgroundColor="#1E293B"
                        Padding="10,6"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 20">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#38A169" VerticalOptions="Center" />
                        <Label Text="{Binding NfcStatusText}" FontSize="11" TextColor="#E2E8F0" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Scan Frame (Target Area) -->
                <Grid HeightRequest="220" 
                      WidthRequest="220" 
                      HorizontalOptions="Center">
                    <BoxView HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="32" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="4" HeightRequest="32" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="Start" WidthRequest="32" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="Start" WidthRequest="4" HeightRequest="32" Color="#FF8C00" />
                    <BoxView HorizontalOptions="Start" VerticalOptions="End" WidthRequest="32" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="Start" VerticalOptions="End" WidthRequest="4" HeightRequest="32" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="End" WidthRequest="32" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="End" WidthRequest="4" HeightRequest="32" Color="#FF8C00" />
                    <BoxView HeightRequest="2" Color="#FF8C00" VerticalOptions="Center" Opacity="0.4" />
                </Grid>

                <!-- Card Dinâmico de Validação de BOM / NFC -->
                <Border BackgroundColor="#2D3748"
                        Stroke="{Binding ValidationColor}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding StatusMessage}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botões do Modo Resiliente / Demonstração (Para Apresentação da Banca) -->
                <Border BackgroundColor="#283141"
                        Stroke="#4A5568"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="MODO DEMONSTRAÇÃO (APRESENTAÇÃO SEM HARDWARE FÍSICO)" 
                               FontSize="10" 
                               FontAttributes="Bold" 
                               TextColor="#A0AEC0" 
                               HorizontalTextAlignment="Center" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="Simular Insumo Válido (BOM)"
                                    Command="{Binding SimulateValidBOMScanCommand}"
                                    BackgroundColor="#2F855A"
                                    TextColor="White"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="6"
                                    HeightRequest="42" />

                            <Button Grid.Column="1"
                                    Text="Simular Insumo Inválido"
                                    Command="{Binding SimulateInvalidBOMScanCommand}"
                                    BackgroundColor="#C53030"
                                    TextColor="White"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="6"
                                    HeightRequest="42" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="Simular TAG NFC"
                                    Command="{Binding SimulateNfcTagCommand}"
                                    BackgroundColor="#2B6CB0"
                                    TextColor="White"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="6"
                                    HeightRequest="38" />

                            <Button Grid.Column="1"
                                    Text="Digitar Código Manual"
                                    Command="{Binding ManualEntryCommand}"
                                    BackgroundColor="#4A5568"
                                    TextColor="White"
                                    FontSize="11"
                                    CornerRadius="6"
                                    HeightRequest="38" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Bar -->
        <VerticalStackLayout Grid.Row="1" Padding="20,10,20,16" BackgroundColor="#1A202C">
            <Button Text="CONFIRMAR APONTAMENTO" 
                    Command="{Binding ScanResultCommand}"
                    IsEnabled="{Binding CanRegister}"
                    BackgroundColor="#FF8C00" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    HeightRequest="50" 
                    CornerRadius="8" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
