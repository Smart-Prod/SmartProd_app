# PostgreSQL container
POSTGRES_DB=SmartProd
POSTGRES_USER=smartprod
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# Backend
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=SmartProd
JWT_EXPIRES_IN_DAYS=7
CORS_ORIGINS=http://localhost
BACKEND_PORT=5481
ADMIN_INITIAL_EMAIL=admin@smartprod.local
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-secret-of-at-least-12-characters
# Optional: creates a separate platform-level administrator when configured.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend (empty for same-origin API through Nginx)
VITE_API_URL=
FRONTEND_PORT=80
