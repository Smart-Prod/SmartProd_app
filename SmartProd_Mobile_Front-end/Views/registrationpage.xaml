<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartProd_Mobile_Front_end.Views.RegistrationPage"
             Title="Registrar"
             BackgroundColor="#F8F6F2">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="32,40">

            <!-- Header -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,36">
                <Label Text="Criar Conta"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#071E27" />
                <Label Text="Preencha os dados para se cadastrar"
                       FontSize="14"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <!-- Form Card -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="24,32"
                    Margin="0,0,0,32">

                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,4"
                            Radius="16"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <!-- Nome -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="NOME COMPLETO"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,12">
                            <Entry Placeholder="Seu nome"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#071E27"
                                   Text="{Binding Name}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-MAIL"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,12">
                            <Entry Placeholder="seu@email.com"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#071E27"
                                   Keyboard="Email"
                                   Text="{Binding Email}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Senha -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SENHA"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,12">
                            <Entry Placeholder="••••••••"
                                   IsPassword="True"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#071E27"
                                   Text="{Binding Senha}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Button -->
                    <Button Text="CRIAR CONTA"
                            BackgroundColor="#FF8C00"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="52"
                            CornerRadius="10"
                            Margin="0,8,0,0"
                            Command="{Binding RegisterCommand}" />

                    <!-- Login link -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                        <Label Text="Já tem conta?"
                               FontSize="14"
                               TextColor="#6B7280" />
                        <Label Text="Faça login"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#FF8C00" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
