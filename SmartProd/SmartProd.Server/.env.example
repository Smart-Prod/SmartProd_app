# SmartProd Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Database Connection (PostgreSQL)
SMARTPROD_DB_CONNECTION=Host=localhost;Port=5432;Database=SmartProd;Username=postgres;Password=your_secure_password

# JWT Configuration
# Generate a strong secret: openssl rand -base64 64
SMARTPROD_JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Optional: Override issuer (default: SmartProd)
# SMARTPROD_JWT_ISSUER=SmartProd

# Optional: Token expiration in days (default: 7)
# SMARTPROD_JWT_EXPIRES_IN_DAYS=7