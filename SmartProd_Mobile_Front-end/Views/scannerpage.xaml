<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartProd_Mobile_Front_end.Views.ScannerPage"
             Title="Scanner"
             BackgroundColor="#071E27">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,16"
              BackgroundColor="Transparent">

            <ImageButton Grid.Column="0"
                         Source="menu_icon.png"
                         WidthRequest="24"
                         HeightRequest="24"
                         BackgroundColor="Transparent"
                         SemanticProperties.Description="Abrir menu" />

            <Label Grid.Column="1"
                   Text="SMARTPROD"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   CharacterSpacing="2"
                   VerticalOptions="Center" />

            <Border Grid.Column="2"
                    HeightRequest="40"
                    WidthRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20">
                <Image Source="operator_avatar.png" Aspect="AspectFill" />
            </Border>
        </Grid>

        <!-- Scanner Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" VerticalOptions="Center" Padding="30">

                <!-- Badge -->
                <Border BackgroundColor="#FF8C00"
                        Padding="14,6"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Label Text="SCANNER ATIVO"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="White"
                           CharacterSpacing="1" />
                </Border>

                <Label Text="Posicione o QR Code"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="Centralize o código de barras do componente no quadro para registrar o uso da ferramenta."
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.7"
                       HorizontalTextAlignment="Center" />

                <!-- Scan Frame -->
                <Grid HeightRequest="260"
                      WidthRequest="260"
                      HorizontalOptions="Center"
                      MaximumWidthRequest="260">

                    <BoxView HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="36" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="4" HeightRequest="36" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="Start" WidthRequest="36" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="Start" WidthRequest="4" HeightRequest="36" Color="#FF8C00" />
                    <BoxView HorizontalOptions="Start" VerticalOptions="End" WidthRequest="36" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="Start" VerticalOptions="End" WidthRequest="4" HeightRequest="36" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="End" WidthRequest="36" HeightRequest="4" Color="#FF8C00" />
                    <BoxView HorizontalOptions="End" VerticalOptions="End" WidthRequest="4" HeightRequest="36" Color="#FF8C00" />

                    <!-- Scanning Line -->
                    <BoxView HeightRequest="2" Color="#FF8C00" VerticalOptions="Center" Opacity="0.4" />
                </Grid>

                <!-- Stats -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                    <Border Grid.Column="0"
                            BackgroundColor="#0F2E3A"
                            Stroke="#FF8C00"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="PROGRESSO"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#FF8C00"
                                   CharacterSpacing="1" />
                            <Label Text="{Binding ShiftProgress}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#0F2E3A"
                            Stroke="#059669"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="STATUS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#059669"
                                   CharacterSpacing="1" />
                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#059669" VerticalOptions="Center" />
                                <Label Text="ONLINE"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <Button Text="REGISTRAR USO"
                    Command="{Binding ScanResultCommand}"
                    IsEnabled="{Binding CanRegister}"
                    BackgroundColor="#FF8C00"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="20,0,20,16" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
